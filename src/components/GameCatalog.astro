---
import GameCard from './GameCard.astro';
import EmptyState from './EmptyState.astro';
import type { Game } from '../types/game';

interface Props {
  games: Game[];
  categories: NonNullable<Game['category']>[];
  publishers: NonNullable<Game['publisher']>[];
  currentPage: number;
  totalPages: number;
}

const { games, categories, publishers, currentPage, totalPages } = Astro.props;
const pageHref = (page: number): string => page === 1 ? '/' : `/page/${page}`;
---

{games.length === 0 ? (
  <EmptyState text="No games available at the moment." />
) : (
  <>
    <form
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
      data-testid="game-filters"
      aria-label="Filter games"
    >
      <div class="grid gap-6 md:grid-cols-[2fr_1fr_auto] md:items-end">
        <fieldset>
          <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  data-testid={`category-filter-${category.id}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="text-sm font-semibold text-slate-200">
          <span class="mb-3 block">Publisher</span>
          <select
            name="publisher"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </label>

        <button
          type="reset"
          data-testid="clear-filters"
          class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
          Clear filters
        </button>
      </div>
      <p class="mt-4 text-sm text-slate-400" data-testid="filter-results" role="status" aria-live="polite">
        Showing {games.length} games
      </p>
    </form>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
      {games.map((game) => <GameCard game={game} />)}
    </div>
    <div class="mt-6 hidden" data-testid="filter-empty-state">
      <EmptyState text="No games match the selected filters." />
    </div>

    {totalPages > 1 && (
      <nav class="mt-10 flex items-center justify-center gap-4" aria-label="Game pagination" data-testid="pagination">
        {currentPage > 1 ? (
          <a
            href={pageHref(currentPage - 1)}
            data-testid="pagination-previous"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Previous
          </a>
        ) : (
          <span class="rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-500" aria-disabled="true">
            Previous
          </span>
        )}
        <span class="text-sm text-slate-300" data-testid="pagination-status">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages ? (
          <a
            href={pageHref(currentPage + 1)}
            data-testid="pagination-next"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Next
          </a>
        ) : (
          <span class="rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-500" aria-disabled="true">
            Next
          </span>
        )}
      </nav>
    )}
  </>
)}

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');

  if (filterForm && gamesGrid && emptyState && results) {
    const categoryInputs = Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInput = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const cards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    let selectedPublisher = new URLSearchParams(window.location.search).get('publisher') ?? '';

    const applyFilters = (updateUrl: boolean): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      if (updateUrl) selectedPublisher = publisherInput?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches;
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      emptyState.classList.toggle('hidden', visibleCount > 0);
      results.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;

      if (updateUrl) {
        const params = new URLSearchParams();
        categoryInputs.filter((input) => input.checked).forEach((input) => params.append('category', input.value));
        if (selectedPublisher) params.set('publisher', selectedPublisher);
        const query = params.toString();
        window.history.replaceState({}, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
      }
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput && publisherInput.querySelector(`option[value="${selectedPublisher}"]`)) {
      publisherInput.value = selectedPublisher;
    }

    filterForm.addEventListener('input', () => applyFilters(true));
    filterForm.addEventListener('reset', () => {
      window.setTimeout(() => applyFilters(true), 0);
    });
    applyFilters(false);
  }
</script>
